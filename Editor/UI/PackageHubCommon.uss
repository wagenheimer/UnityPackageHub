/* =========================================================================
 * Wagenheimer Package Hub - Modern Dark Themed UI Toolkit Stylesheet
 * Compatible with Unity 2021.3+ UI Toolkit
 * Author: Cezar Wagenheimer
 * ========================================================================= */

.hub-root {
    flex-grow: 1;
    background-color: #13151B;
    color: #F1F5F9;
    padding: 12px 16px;
    font-size: 12px;
}

/* ---------------- HEADER BANNER ---------------- */
.hub-header {
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 12px;
    border-left-width: 4px;
    border-left-color: #38BDF8;
}

.hub-header-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hub-title-group {
    flex-direction: column;
}

.hub-title-row {
    flex-direction: row;
    align-items: center;
}

.hub-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 0.5px;
}

.hub-author-badge {
    background-color: rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.35);
    border-width: 1px;
    border-radius: 12px;
    padding: 2px 8px;
    margin-left: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #7DD3FC;
}

.hub-subtitle {
    font-size: 11px;
    color: #94A3B8;
    margin-top: 3px;
}

.hub-header-links {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.hub-header-link {
    font-size: 11px;
    color: #38BDF8;
    -unity-font-style: bold;
    cursor: link;
    margin-right: 12px;
}

.hub-header-link:hover {
    color: #7DD3FC;
}

.hub-header-actions {
    flex-direction: row;
    align-items: center;
}

.hub-header-actions > Button {
    margin-left: 8px;
}

/* ---------------- QUICK LAUNCH DASHBOARDS BAR ---------------- */
.hub-quickbar {
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 12px;
}

.hub-quickbar-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.hub-quickbar-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #38BDF8;
    letter-spacing: 0.5px;
}

.hub-quickbar-chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.hub-chip-btn {
    flex-direction: row;
    align-items: center;
    background-color: #242938;
    border-color: #384256;
    border-width: 1px;
    border-radius: 6px;
    padding: 5px 11px;
    margin-right: 6px;
    margin-bottom: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #E2E8F0;
    transition-duration: 0.12s;
    transition-property: background-color, border-color;
}

.hub-chip-btn:hover {
    background-color: rgba(56, 189, 248, 0.2);
    border-color: #38BDF8;
    color: #FFFFFF;
}

.hub-chip-btn--active {
    background-color: #1E3A8A;
    border-color: #3B82F6;
    color: #FFFFFF;
}

/* ---------------- METRICS BAR ---------------- */
.hub-metrics-row {
    flex-direction: row;
    margin-bottom: 12px;
}

.hub-metric-card {
    flex-grow: 1;
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 7px;
    padding: 10px 12px;
    margin-right: 8px;
    align-items: center;
}

.hub-metric-card:last-child {
    margin-right: 0;
}

.hub-metric-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.hub-metric-label {
    font-size: 10px;
    color: #94A3B8;
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* ---------------- TAB BAR ---------------- */
.hub-tab-bar {
    flex-direction: row;
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 7px;
    padding: 3px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.hub-tab-btn {
    flex-grow: 1;
    height: 32px;
    border-radius: 5px;
    border-width: 0;
    background-color: transparent;
    color: #94A3B8;
    font-size: 11.5px;
    -unity-font-style: bold;
    padding: 4px 10px;
    margin: 0 2px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.hub-tab-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}

.hub-tab-btn--active {
    background-color: #2563EB;
    color: #FFFFFF;
}

.hub-tab-btn--active:hover {
    background-color: #1D4ED8;
    color: #FFFFFF;
}

/* ---------------- SEARCH & FILTER BAR ---------------- */
.hub-search-toolbar {
    flex-direction: row;
    align-items: center;
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 10px;
    margin-bottom: 12px;
}

.hub-search-field {
    flex-grow: 1;
    margin-right: 10px;
}

.hub-filter-chips {
    flex-direction: row;
    align-items: center;
}

.hub-filter-chip {
    padding: 3px 8px;
    border-radius: 4px;
    background-color: #242938;
    border-width: 1px;
    border-color: #384256;
    color: #94A3B8;
    font-size: 10.5px;
    margin-left: 4px;
}

.hub-filter-chip:hover {
    background-color: #2D3547;
    color: #FFFFFF;
}

.hub-filter-chip--active {
    background-color: #38BDF8;
    border-color: #38BDF8;
    color: #0F172A;
    -unity-font-style: bold;
}

/* ---------------- CONTENT AREA ---------------- */
.hub-content-container {
    flex-grow: 1;
}

/* ---------------- CARDS ---------------- */
.hub-card {
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 10px;
}

.hub-card:hover {
    border-color: #3B4459;
}

.hub-card--focused {
    border-color: #38BDF8;
    background-color: #1D2332;
}

.hub-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.hub-card-identity {
    flex-direction: row;
    align-items: center;
}

.hub-card-title {
    font-size: 13.5px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.hub-card-category {
    background-color: #242938;
    border-color: #384256;
    border-width: 1px;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    color: #94A3B8;
    margin-left: 8px;
}

.hub-card-badges {
    flex-direction: row;
    align-items: center;
}

.hub-card-actions {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

.hub-card-desc {
    font-size: 11.5px;
    color: #CBD5E1;
    margin-top: 4px;
    margin-bottom: 6px;
    white-space: normal;
}

.hub-card-meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
    padding-top: 8px;
    margin-top: 4px;
}

.hub-card-id {
    font-size: 10px;
    color: #64748B;
    -unity-font-style: bold;
}

.hub-shortcuts-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

/* ---------------- BUTTONS ---------------- */
.hub-btn {
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: #384256;
    background-color: #242938;
    color: #E2E8F0;
    cursor: link;
    transition-duration: 0.12s;
    transition-property: background-color, border-color;
}

.hub-btn:hover {
    background-color: #2E3547;
    color: #FFFFFF;
}

.hub-btn-primary {
    background-color: #2563EB;
    border-color: #3B82F6;
    color: #FFFFFF;
}

.hub-btn-primary:hover {
    background-color: #1D4ED8;
    border-color: #60A5FA;
}

.hub-btn-dashboard {
    background-color: #0E7490;
    border-color: #06B6D4;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.hub-btn-dashboard:hover {
    background-color: #0891B2;
    border-color: #22D3EE;
    color: #FFFFFF;
}

.hub-btn-success {
    background-color: #059669;
    border-color: #10B981;
    color: #FFFFFF;
}

.hub-btn-success:hover {
    background-color: #047857;
    border-color: #34D399;
}

.hub-btn-warning {
    background-color: #D97706;
    border-color: #F59E0B;
    color: #FFFFFF;
}

.hub-btn-warning:hover {
    background-color: #B45309;
    border-color: #FBBF24;
}

.hub-btn-secondary {
    background-color: #242938;
    border-color: #384256;
    color: #E2E8F0;
}

.hub-btn-secondary:hover {
    background-color: #2E3547;
    color: #FFFFFF;
}

.hub-btn-sm {
    padding: 3px 8px;
    font-size: 10px;
    margin-right: 4px;
}

/* ---------------- BADGES ---------------- */
.hub-badge {
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 10px;
    -unity-font-style: bold;
    border-width: 1px;
    margin-left: 6px;
}

.hub-badge-pass {
    background-color: rgba(16, 185, 129, 0.15);
    border-color: #10B981;
    color: #6EE7B7;
}

.hub-badge-update {
    background-color: rgba(245, 158, 11, 0.18);
    border-color: #F59E0B;
    color: #FCD34D;
}

.hub-badge-info {
    background-color: rgba(56, 189, 248, 0.15);
    border-color: #38BDF8;
    color: #7DD3FC;
}

.hub-badge-neutral {
    background-color: #242938;
    border-color: #384256;
    color: #94A3B8;
}

/* ---------------- RELEASE NOTES ACCORDION ---------------- */
.hub-notes-container {
    background-color: #12141A;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 6px;
    padding: 10px 12px;
    margin-top: 8px;
}

.hub-notes-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: #38BDF8;
    margin-bottom: 6px;
}

.hub-notes-text {
    font-size: 11px;
    color: #CBD5E1;
    white-space: normal;
}

/* ---------------- ABOUT VIEW STYLING ---------------- */
.hub-about-hero {
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 8px;
    padding: 18px;
    margin-bottom: 12px;
    border-left-width: 4px;
    border-left-color: #38BDF8;
}

.hub-hero-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.hub-hero-subtitle {
    font-size: 12px;
    color: #38BDF8;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 8px;
}

.hub-hero-bio {
    font-size: 12px;
    color: #CBD5E1;
    white-space: normal;
    margin-bottom: 12px;
}

.hub-hero-socials {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.hub-principle-card {
    background-color: #1E222D;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 8px;
}

.hub-principle-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 3px;
}

.hub-principle-desc {
    font-size: 11px;
    color: #94A3B8;
    white-space: normal;
}

.hub-ecosystem-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.hub-ecosystem-cell {
    width: 49%;
    background-color: #1E222D;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 8px;
}

/* ---------------- FOOTER ---------------- */
.hub-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #1A1D26;
    border-color: #2D3342;
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 12px;
    margin-top: 10px;
}

.hub-footer-text {
    font-size: 10.5px;
    color: #64748B;
}

.hub-footer-links {
    flex-direction: row;
    align-items: center;
}
